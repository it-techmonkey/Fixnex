# Database (required)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth (required for login/signup on Vercel and locally)
JWT_SECRET="your-long-random-secret-at-least-32-chars"

# App URL (required for CCAvenue callback redirect)
# Local development: use ngrok or similar to expose localhost
# Production: your actual domain e.g. https://fixnex.com
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# CCAvenue Payment Gateway
# Get these from your CCAvenue merchant dashboard → Profile → Payment Gateway Settings
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
# TEST uses the sandbox; PROD uses the live gateway
CCAVENUE_ENV=TEST
