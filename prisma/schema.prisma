// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String?
  authProvider     AuthProvider      @default(LOCAL)
  fullName         String
  customer_code    String?           @unique // readable ID, e.g. HARSHALTARWALE001 (new users only)
  countryCode      String?           @db.VarChar(8)
  phoneNumber      String?           @db.VarChar(20)
  role             UserRole          @default(USER)
  passwordChangedAt DateTime?        // sessions issued before this are rejected
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bookings         Booking[]
  cart             Cart?
  passwordResetTokens PasswordResetToken[]
  subscriptions    Subscription[]
  enquiries        Enquiry[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model Service {
  id               String            @id @default(cuid())
  name             String
  normal_price     String
  member_price     String
  icon             String
  category_id      String
  category         ServiceCategory   @relation(fields: [category_id], references: [id], onDelete: Cascade)
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  carts            Cart[]
  bookingCartItems BookingCartItem[]

  @@unique([name, category_id])
  @@map("services")
}

model ServiceCategory {
  id         String    @id @default(cuid())
  name       String    @unique
  services   Service[]
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@map("service_categories")
}

model Booking {
  id             String    @id @default(cuid())
  booking_code   String?   @unique // readable ID, e.g. FNX-AC-1001 (new bookings only)
  bookingCartItems BookingCartItem[]
  user_id        String?
  user           User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  guest_name     String?
  guest_email    String?
  guest_phone    String?
  category_name  String?
  location       String?
  service_type   String?
  scheduled_date DateTime?
  time_slot      String?
  price          String?
  status         BookingStatus @default(PENDING)
  // Plan details, saved when the booking is made so history stays correct after a plan ends.
  payment_status BookingPaymentStatus @default(UNPAID)
  member_plan    PlanTier?           // the customer's plan at booking time (null = normal customer)
  subscription_id String?
  subscription   Subscription?       @relation(fields: [subscription_id], references: [id], onDelete: SetNull)
  property_scope String?             // PLAN (the plan's property) | OTHER
  is_priority    Boolean   @default(false)
  is_preventive_check Boolean @default(false)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([user_id])
  @@index([subscription_id])
  @@map("bookings")
}

enum BookingPaymentStatus {
  PAID      // paid online
  INCLUDED  // fully covered by the customer's plan (AED 0)
  UNPAID    // e.g. booked through Nex AI chat, pay on visit
}

model Cart {
  id         String    @id @default(cuid())
  services   Service[]
  user_id    String    @unique
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  bookingCartItems BookingCartItem[]
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@map("carts")
}

model BookingCartItem {
  id             String    @id @default(cuid())
  services       Service   @relation(fields: [service_id], references: [id], onDelete: Cascade)
  service_id     String
  cart_id        String?
  cart           Cart?     @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  category_name  String?
  location       String?
  service_type   String?
  scheduled_date DateTime?
  time_slot      String?
  price          String?
  coverage       String?   // INCLUDED (in plan) | MEMBER (member price) | NORMAL, set at checkout
  subscription_id String?  // plan month an INCLUDED item counts against
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  booking        Booking?  @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  booking_id     String?

  @@index([subscription_id])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
  REJECTED
}

// ---------------------------------------------------------------------------
// Payment models
// ---------------------------------------------------------------------------

model PaymentOrder {
  id                     String             @id @default(cuid())
  order_code             String?            @unique // readable ID shown to customers, e.g. FNX-AC-1001 (set on success)
  user_id                String?
  booking_cart_items     String[]           // bookingCartItemId references
  custom_payment_link_id String?            @unique
  custom_payment_link    CustomPaymentLink? @relation(fields: [custom_payment_link_id], references: [id])
  amount                 String
  currency               String             @default("AED")
  status                 PaymentOrderStatus @default(PENDING)
  purpose                PaymentPurpose     @default(BOOKING)
  pricing                Json?              // BOOKING: price per cart item as quoted at checkout
  included_visits        Int                @default(0) // plan visits this order reserves until paid
  plan_request           Json?              // PLAN: what to activate once paid
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt
  payment                Payment?
  subscription           Subscription?

  @@index([user_id])
  @@map("payment_orders")
}

enum PaymentPurpose {
  BOOKING
  PLAN
}

enum PaymentOrderStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id             String       @id @default(cuid())
  order_id       String       @unique
  payment_order  PaymentOrder @relation(fields: [order_id], references: [id])
  transaction_id String?
  tracking_id    String?
  amount         String
  status         String       // CCAvenue raw status: Success | Failure | Aborted | Invalid
  gateway        String       @default("ccavenue")
  raw_response   Json?
  booking_id     String?      // populated after booking created on success
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  @@map("payments")
}

model CustomPaymentLink {
  id             String        @id @default(cuid())
  amount         String
  description    String
  customer_email String?
  status         PaymentOrderStatus @default(PENDING)
  plan_request   Json?         // set when the link pays for a plan (e.g. a FixMax quote)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  payment_order  PaymentOrder?

  @@map("custom_payment_links")
}

// ---------------------------------------------------------------------------
// Plans (FixLite / FixPro / FixMax)
// ---------------------------------------------------------------------------

// One row per paid month. Renewing adds a new row that starts when the previous one ends.
model Subscription {
  id               String    @id @default(cuid())
  code             String    @unique // readable ID, e.g. FNX-PRO-1010
  user_id          String
  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan             PlanTier
  property_type    String    // apartment | family | villa
  property_area    String
  price            String    // monthly price for this month, AED
  visits_included  Int?      // included visits this month; null = unlimited
  visits_bonus     Int       @default(0) // extra visits added by admin
  status           SubscriptionStatus @default(ACTIVE)
  starts_at        DateTime
  ends_at          DateTime
  source           String    @default("online") // online | payment_link | admin
  payment_order_id String?   @unique
  payment_order    PaymentOrder? @relation(fields: [payment_order_id], references: [id])
  cancelled_at     DateTime?
  reminder_sent_at DateTime?
  expiry_notice_sent_at DateTime?
  admin_note       String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  bookings         Booking[]

  @@index([user_id, ends_at])
  @@map("subscriptions")
}

enum PlanTier {
  FIXLITE
  FIXPRO
  FIXMAX
}

enum SubscriptionStatus {
  ACTIVE     // paid; active between starts_at and ends_at
  CANCELLED  // stopped by admin
}

// Plan enquiries and quote requests from the website.
model Enquiry {
  id             String    @id @default(cuid())
  user_id        String?
  user           User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  name           String
  email          String
  phone          String
  plan_id        String
  plan_name      String
  type           String    // enquiry | subscription
  property_type  String?
  property_label String?
  price          String?
  facilities     String[]
  message        String?
  status         EnquiryStatus @default(NEW)
  admin_note     String?
  email_sent     Boolean   @default(false)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([status, created_at])
  @@map("enquiries")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

// Running numbers for readable IDs (customer codes per name, booking codes).
model IdCounter {
  key   String @id
  value Int    @default(0)

  @@map("id_counters")
}

// One-time password reset links. Only a hash of the token is stored.
model PasswordResetToken {
  id         String    @id @default(cuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id])
  @@map("password_reset_tokens")
}

// Counters for throttling login / password reset attempts.
model RateLimit {
  key      String   @id
  count    Int      @default(0)
  reset_at DateTime

  @@map("rate_limits")
}
